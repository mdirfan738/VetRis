# Copy this file to `.env` and adjust if needed. `.env` is gitignored —
# only this template (no real secrets) is meant to be committed.
# docker-compose.yml reads this automatically for local development.

# --- JWT (local dev only — production gets this from Secrets Manager via Terraform) ---
VETRIS_DEV_JWT_KEY=local-development-only-signing-key-replace-me-32-chars-min

# --- PACS (optional locally — leave as-is if you're not testing DICOM writeback) ---
VETRIS_DEV_PACS_HOST=localhost

# --- AWS (leave blank to use your `aws configure` default profile/credentials) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
